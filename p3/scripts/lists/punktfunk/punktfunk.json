        "category": "game",
        "icon": "./punktfunk.svg",
        "type": "native",
        "desktop": ["gnome", "plasma", "hyprland", "sway"],
        "package-name": {
            "ubuntu": ["punktfunk-host", "punktfunk-web", "punktfunk-scripting"],
            "debian": ["punktfunk-host", "punktfunk-web", "punktfunk-scripting"],
            "fedora": ["punktfunk", "punktfunk-web", "punktfunk-scripting"],
            "arch": ["punktfunk-host", "punktfunk-web", "punktfunk-scripting"],
            "cachy": ["punktfunk-host", "punktfunk-web", "punktfunk-scripting"]
        },
        "overrides": {
            "pre": {
                "script": "./punktfunk-pre.sh"
            },
            "post": {
                "script": "./punktfunk-post.sh"
            }
        },
        "services": {
            "user": [ "punktfunk-host", "punktfunk-web" ]
        },
        "descriptions": "descriptions.json",
        "donate": "https://ko-fi.com/punktfunk"
    }
